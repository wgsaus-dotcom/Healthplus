{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hpi-website",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hai-website",
      "database_id": "53ebf718-97a3-4cb0-b3d8-92ac5673952c",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "hpi-website-resumes"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
